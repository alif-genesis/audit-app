{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/evidence/[...path]",
      "regex": "^/api/evidence/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/evidence/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/dashboard/audit-types/[id]",
      "regex": "^/dashboard/audit\\-types/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/audit\\-types/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/audits/findings/[auditId]",
      "regex": "^/dashboard/audits/findings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPauditId": "nxtPauditId"
      },
      "namedRegex": "^/dashboard/audits/findings/(?<nxtPauditId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/audits/responses/[auditId]",
      "regex": "^/dashboard/audits/responses/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPauditId": "nxtPauditId"
      },
      "namedRegex": "^/dashboard/audits/responses/(?<nxtPauditId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/audits/[id]/summary",
      "regex": "^/dashboard/audits/([^/]+?)/summary(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/audits/(?<nxtPid>[^/]+?)/summary(?:/)?$"
    },
    {
      "page": "/dashboard/capa/[auditId]",
      "regex": "^/dashboard/capa/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPauditId": "nxtPauditId"
      },
      "namedRegex": "^/dashboard/capa/(?<nxtPauditId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/companies/[id]",
      "regex": "^/dashboard/companies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/companies/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/design-factors/[id]",
      "regex": "^/dashboard/design\\-factors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/design\\-factors/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
