generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AUDITEE
  AUDITOR
}

model Company {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?  @unique
  email        String?
  phone        String?
  website      String?
  industry     String?
  taxId        String?  @map("tax_id")
  address      String?
  description  String?
  picName      String?  @map("pic_name")
  activeAudits Int      @default(0) @map("active_audits")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([code])
  @@map("companies")
}

model AuditType {
  id          String   @id @default(cuid())
  name        String
  isoStandard String   @map("iso_standard")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  questions AuditQuestion[]
  audits Audit[]

  @@index([isoStandard])
  @@map("audit_types")
}

model AuditQuestion {
  id             String   @id @default(cuid())
  auditTypeId    String   @map("audit_type_id")
  clause         String
  title          String?
  requirement    String?
  question       String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  auditType AuditType @relation(fields: [auditTypeId], references: [id], onDelete: Cascade)
  responses AuditResponse[]

  @@index([auditTypeId])
  @@index([clause])
  @@map("audit_questions")
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorName  String   @map("actor_name")
  actorEmail String   @map("actor_email")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  details    String
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("activity_logs")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  companyName  String?  @map("company_name")
  assignedAudits Int    @default(0) @map("assigned_audits")
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  activityLogs ActivityLog[]
  auditeeAssignments AuditAssignment[] @relation("AuditAssignmentAuditee")
  auditorAssignments AuditAssignment[] @relation("AuditAssignmentAuditor")
  auditResponses AuditResponse[]
  uploadedEvidence EvidenceFile[] @relation("EvidenceUploadedBy")
  reviewedAudits Audit[] @relation("AuditReviewedBy")
  approvedAudits Audit[] @relation("AuditApprovedBy")
  auditApprovalLogs AuditApprovalLog[]
  ownedCapaActions CapaAction[] @relation("CapaOwner")
  verifiedCapaActions CapaAction[] @relation("CapaVerifier")
  designFactorAuditeeAssignments DesignFactorAssessment[] @relation("DesignFactorAssessmentAuditee")
  designFactorAuditorAssignments DesignFactorAssessment[] @relation("DesignFactorAssessmentAuditor")
  reviewedDesignFactors DesignFactorAssessment[] @relation("DesignFactorReviewedBy")
  approvedDesignFactors DesignFactorAssessment[] @relation("DesignFactorApprovedBy")

  @@map("users")
}

enum AuditMode {
  GAP_ASSESSMENT
  AUDIT
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEWED
  APPROVED
}

enum ComplianceStatus {
  COMPLY
  NOT_COMPLY
  NA
}

enum FindingLevel {
  MAJOR
  MINOR
  OFI
  PASS
}

enum DesignFactorAssessmentStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  APPROVED
}

enum ApprovalTargetType {
  AUDIT
  DESIGN_FACTOR
}

enum ApprovalDecision {
  REVIEW
  APPROVE
  REJECT
  REOPEN
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  VERIFICATION
  CLOSED
  REJECTED
}

model Audit {
  id               String     @id @default(cuid())
  title            String
  companyName      String     @map("company_name")
  auditTypeId      String     @map("audit_type_id")
  mode             AuditMode
  status           AuditStatus @default(DRAFT)
  startDate        DateTime   @map("start_date")
  endDate          DateTime?  @map("end_date")
  description      String?
  reviewedAt       DateTime?  @map("reviewed_at")
  reviewedById     String?    @map("reviewed_by_id")
  approvedAt       DateTime?  @map("approved_at")
  approvedById     String?    @map("approved_by_id")
  approvalNote     String?    @map("approval_note")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  auditType AuditType @relation(fields: [auditTypeId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("AuditReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("AuditApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  assignments AuditAssignment[]
  responses AuditResponse[]
  findings AuditFinding[]
  approvalLogs AuditApprovalLog[]

  @@index([companyName])
  @@index([auditTypeId])
  @@index([status])
  @@index([reviewedById])
  @@index([approvedById])
  @@map("audits")
}

model AuditAssignment {
  id           String   @id @default(cuid())
  auditId      String   @map("audit_id")
  auditorId    String?  @map("auditor_id")
  auditeeId    String   @map("auditee_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditor User? @relation("AuditAssignmentAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  auditee User @relation("AuditAssignmentAuditee", fields: [auditeeId], references: [id], onDelete: Cascade)

  @@unique([auditId, auditeeId])
  @@index([auditId])
  @@index([auditorId])
  @@index([auditeeId])
  @@map("audit_assignments")
}

model AuditResponse {
  id          String   @id @default(cuid())
  auditId     String   @map("audit_id")
  auditeeId   String   @map("auditee_id")
  questionId  String   @map("question_id")
  compliance  ComplianceStatus @map("compliance")
  description String?
  notes       String?
  attachments String[] @default([])
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditee User @relation(fields: [auditeeId], references: [id], onDelete: Cascade)
  question AuditQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evidenceFiles EvidenceFile[]
  findings AuditFinding[]

  @@unique([auditId, auditeeId, questionId])
  @@index([auditId])
  @@index([auditeeId])
  @@index([questionId])
  @@map("audit_responses")
}

model EvidenceFile {
  id              String   @id @default(cuid())
  auditResponseId String   @map("audit_response_id")
  auditId         String   @map("audit_id")
  questionId      String   @map("question_id")
  uploadedById    String   @map("uploaded_by_id")
  originalName    String   @map("original_name")
  storedName      String   @map("stored_name")
  storagePath     String   @map("storage_path")
  downloadPath    String   @unique @map("download_path")
  mimeType        String   @map("mime_type")
  fileSize        Int      @map("file_size")
  checksumSha256  String   @map("checksum_sha256")
  version         Int
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  auditResponse AuditResponse @relation(fields: [auditResponseId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([auditResponseId, version, storedName])
  @@index([auditId])
  @@index([questionId])
  @@index([uploadedById])
  @@index([checksumSha256])
  @@map("evidence_files")
}

model AuditFinding {
  id          String   @id @default(cuid())
  auditId     String   @map("audit_id")
  responseId  String?  @map("response_id")
  level       FindingLevel
  description String?
  recommendation String?
  status      String? @default("OPEN")
  dueDate     DateTime? @map("due_date")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  response AuditResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  capaActions CapaAction[]

  @@unique([auditId, responseId])
  @@index([auditId])
  @@index([responseId])
  @@map("audit_findings")
}

model CapaAction {
  id                String     @id @default(cuid())
  findingId         String     @map("finding_id")
  ownerId           String     @map("owner_id")
  status            CapaStatus @default(OPEN)
  rootCause         String?    @map("root_cause")
  correctiveAction  String?    @map("corrective_action")
  dueDate           DateTime?  @map("due_date")
  evidenceNotes     String?    @map("evidence_notes")
  verificationNotes String?    @map("verification_notes")
  verifiedById      String?    @map("verified_by_id")
  verifiedAt        DateTime?  @map("verified_at")
  closedAt          DateTime?  @map("closed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  owner User @relation("CapaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  verifiedBy User? @relation("CapaVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@map("capa_actions")
}

model AuditApprovalLog {
  id             String             @id @default(cuid())
  targetType     ApprovalTargetType @map("target_type")
  auditId        String?            @map("audit_id")
  designFactorId String?            @map("design_factor_id")
  actorId        String             @map("actor_id")
  decision       ApprovalDecision
  fromStatus     String             @map("from_status")
  toStatus       String             @map("to_status")
  note           String?
  createdAt      DateTime           @default(now()) @map("created_at")

  audit Audit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  designFactor DesignFactorAssessment? @relation(fields: [designFactorId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType])
  @@index([auditId])
  @@index([designFactorId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_approval_logs")
}

model DesignFactorAssessment {
  id          String   @id @default(cuid())
  name        String
  companyName String   @map("company_name")
  auditorId   String   @map("auditor_id")
  auditeeId   String   @map("auditee_id")
  targetScore Float?   @map("target_score")
  startDate   DateTime @map("start_date")
  dueDate     DateTime? @map("due_date")
  description String?
  status      DesignFactorAssessmentStatus @default(IN_PROGRESS)
  submittedAt DateTime? @map("submitted_at")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedById String? @map("reviewed_by_id")
  approvedAt DateTime? @map("approved_at")
  approvedById String? @map("approved_by_id")
  approvalNote String? @map("approval_note")
  savedState Json @default("{}") @map("saved_state")
  reportContent Json @default("{}") @map("report_content")
  df01AuditeeSubmittedAt DateTime? @map("df01_auditee_submitted_at")
  df01AuditorSubmittedAt DateTime? @map("df01_auditor_submitted_at")
  df02AuditeeSubmittedAt DateTime? @map("df02_auditee_submitted_at")
  df02AuditorSubmittedAt DateTime? @map("df02_auditor_submitted_at")
  df03AuditeeSubmittedAt DateTime? @map("df03_auditee_submitted_at")
  df03AuditorSubmittedAt DateTime? @map("df03_auditor_submitted_at")
  df04AuditeeSubmittedAt DateTime? @map("df04_auditee_submitted_at")
  df04AuditorSubmittedAt DateTime? @map("df04_auditor_submitted_at")
  df05AuditeeSubmittedAt DateTime? @map("df05_auditee_submitted_at")
  df05AuditorSubmittedAt DateTime? @map("df05_auditor_submitted_at")
  df06AuditeeSubmittedAt DateTime? @map("df06_auditee_submitted_at")
  df06AuditorSubmittedAt DateTime? @map("df06_auditor_submitted_at")
  df07AuditeeSubmittedAt DateTime? @map("df07_auditee_submitted_at")
  df07AuditorSubmittedAt DateTime? @map("df07_auditor_submitted_at")
  df08AuditeeSubmittedAt DateTime? @map("df08_auditee_submitted_at")
  df08AuditorSubmittedAt DateTime? @map("df08_auditor_submitted_at")
  df09AuditeeSubmittedAt DateTime? @map("df09_auditee_submitted_at")
  df09AuditorSubmittedAt DateTime? @map("df09_auditor_submitted_at")
  df10AuditeeSubmittedAt DateTime? @map("df10_auditee_submitted_at")
  df10AuditorSubmittedAt DateTime? @map("df10_auditor_submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  auditor User @relation("DesignFactorAssessmentAuditor", fields: [auditorId], references: [id], onDelete: Restrict)
  auditee User @relation("DesignFactorAssessmentAuditee", fields: [auditeeId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("DesignFactorReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("DesignFactorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  df01Input DesignFactorDf01Input?
  df02Input DesignFactorDf02Input?
  df03Input DesignFactorDf03Input?
  df04Input DesignFactorDf04Input?
  df05Input DesignFactorDf05Input?
  df06Input DesignFactorDf06Input?
  df07Input DesignFactorDf07Input?
  df08Input DesignFactorDf08Input?
  df09Input DesignFactorDf09Input?
  df10Input DesignFactorDf10Input?
  objectiveResults DesignFactorObjectiveResult[]
  approvalLogs AuditApprovalLog[]

  @@index([companyName])
  @@index([auditorId])
  @@index([auditeeId])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([status])
  @@map("design_factor_assessments")
}

model DesignFactorDf01Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  growthImportance Float @default(1) @map("growth_importance")
  growthBaseline   Float @default(3) @map("growth_baseline")
  innovationImportance Float @default(1) @map("innovation_importance")
  innovationBaseline   Float @default(3) @map("innovation_baseline")
  costImportance Float @default(1) @map("cost_importance")
  costBaseline   Float @default(3) @map("cost_baseline")
  serviceImportance Float @default(1) @map("service_importance")
  serviceBaseline   Float @default(3) @map("service_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df01_inputs")
}

model DesignFactorDf02Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  rows          Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df02_inputs")
}

model DesignFactorDf03Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  rows          Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df03_inputs")
}

model DesignFactorDf04Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  rows          Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df04_inputs")
}

model DesignFactorDf05Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  highImportance Float @default(100) @map("high_importance")
  highBaseline   Float @default(33) @map("high_baseline")
  normalImportance Float @default(100) @map("normal_importance")
  normalBaseline   Float @default(67) @map("normal_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df05_inputs")
}

model DesignFactorDf06Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  highImportance Float @default(25) @map("high_importance")
  highBaseline   Float @default(0) @map("high_baseline")
  normalImportance Float @default(75) @map("normal_importance")
  normalBaseline   Float @default(100) @map("normal_baseline")
  lowImportance Float @default(0) @map("low_importance")
  lowBaseline   Float @default(0) @map("low_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df06_inputs")
}

model DesignFactorDf07Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  supportImportance Float @default(1) @map("support_importance")
  supportBaseline   Float @default(3) @map("support_baseline")
  factoryImportance Float @default(1) @map("factory_importance")
  factoryBaseline   Float @default(3) @map("factory_baseline")
  turnaroundImportance Float @default(2) @map("turnaround_importance")
  turnaroundBaseline   Float @default(3) @map("turnaround_baseline")
  strategicImportance Float @default(5) @map("strategic_importance")
  strategicBaseline   Float @default(3) @map("strategic_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df07_inputs")
}

model DesignFactorDf08Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  outsourcingImportance Float @default(100) @map("outsourcing_importance")
  outsourcingBaseline   Float @default(33) @map("outsourcing_baseline")
  cloudImportance Float @default(50) @map("cloud_importance")
  cloudBaseline   Float @default(33) @map("cloud_baseline")
  insourcingImportance Float @default(20) @map("insourcing_importance")
  insourcingBaseline   Float @default(34) @map("insourcing_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df08_inputs")
}

model DesignFactorDf09Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  agileImportance Float @default(50) @map("agile_importance")
  agileBaseline   Float @default(15) @map("agile_baseline")
  devOpsImportance Float @default(10) @map("devops_importance")
  devOpsBaseline   Float @default(10) @map("devops_baseline")
  traditionalImportance Float @default(40) @map("traditional_importance")
  traditionalBaseline   Float @default(75) @map("traditional_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df09_inputs")
}

model DesignFactorDf10Input {
  id            String   @id @default(cuid())
  assessmentId  String   @unique @map("assessment_id")
  firstMoverImportance Float @default(75) @map("first_mover_importance")
  firstMoverBaseline   Float @default(15) @map("first_mover_baseline")
  followerImportance Float @default(15) @map("follower_importance")
  followerBaseline   Float @default(70) @map("follower_baseline")
  slowAdopterImportance Float @default(10) @map("slow_adopter_importance")
  slowAdopterBaseline   Float @default(15) @map("slow_adopter_baseline")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("design_factor_df10_inputs")
}

model DesignFactorObjectiveResult {
  id                 String   @id @default(cuid())
  assessmentId       String   @map("assessment_id")
  objective          String
  score              Float
  baselineScore      Float    @map("baseline_score")
  relativeImportance Float    @map("relative_importance")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  assessment DesignFactorAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, objective])
  @@index([assessmentId])
  @@index([objective])
  @@map("design_factor_objective_results")
}
